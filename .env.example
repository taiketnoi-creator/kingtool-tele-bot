# Lấy API ID/API hash tại https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=thay_bang_api_hash_cua_ban

# Không cần dấu @; ví dụ: prodsellerbot
BOT_USERNAME=prodsellerbot

# Tên file phiên đăng nhập cục bộ, không commit/chia sẻ file này
SESSION_NAME=safe-analyzer

# Số tầng menu tối đa và thời gian chờ giữa các thao tác
MAX_DEPTH=2
DELAY_SECONDS=2

# API Key đại lý từ @ProdSellerBot
PRODSELLER_API_KEY=psk_thay_bang_api_key_cua_ban

# Token của Bot bán hàng (tạo tại @BotFather)
RESELLER_BOT_TOKEN=123456789:AAH_thay_bang_bot_token_cua_ban
ADMIN_TELEGRAM_IDS=8110826820

# Chuỗi kết nối Supabase PostgreSQL (Session Pooler IPv4)
DATABASE_URL=postgresql://postgres.xxxxx:MAT_KHAU@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
